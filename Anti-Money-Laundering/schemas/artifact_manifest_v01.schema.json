{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccem.artifact_manifest/v0.1",
  "type": "object",
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": "ccem.artifact_manifest/v0.1"},
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "format", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "format": {"enum": ["csv", "parquet", "json", "jsonl"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "additionalProperties": false
}
