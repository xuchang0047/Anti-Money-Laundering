{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccem.local/schemas/candidate_subgraph_v0.2.schema.json",
  "title": "CandidateSubgraphPackage v0.2",
  "type": "object",
  "required": ["schema_version", "package_type", "case_id", "graph", "analysis_context", "mutation", "provenance"],
  "properties": {
    "schema_version": {"const": "ccem.candidate_subgraph/v0.2"},
    "package_type": {"const": "candidate_subgraph"},
    "case_id": {"type": "string", "minLength": 1},
    "graph": {"$ref": "#/$defs/graph"},
    "analysis_context": {
      "type": "object",
      "required": ["requested_validation_target"],
      "properties": {
        "requested_validation_target": {"enum": ["aml_outcome", "model_behavior"]}
      }
    },
    "mutation": {"type": ["object", "null"]},
    "provenance": {
      "type": "object",
      "required": ["source_dataset_id", "generator_version"]
    }
  },
  "not": {"required": ["validation"]},
  "$defs": {
    "graph": {
      "type": "object",
      "required": ["directed", "multigraph", "time_unit", "time_precision", "time_origin", "amount_mode", "nodes", "edges"],
      "properties": {
        "directed": {"const": true},
        "multigraph": {"const": true},
        "time_unit": {"enum": ["millisecond", "second", "minute", "hour", "day"]},
        "time_precision": {"type": "number", "exclusiveMinimum": 0},
        "time_origin": {"type": ["string", "null"]},
        "amount_mode": {"enum": ["dual_endpoint", "base_only", "receiver_only"]},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["node_id", "attrs"],
            "properties": {"node_id": {"type": "string", "minLength": 1}, "attrs": {"type": "object"}}
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["edge_id", "src", "dst", "timestamp", "base_amount", "base_currency", "amount_sent", "sent_currency", "amount_received", "receiving_currency", "transaction_type", "payment_format", "scope", "parent_edge_ids", "mutation_role"],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "src": {"type": "string", "minLength": 1},
        "dst": {"type": "string", "minLength": 1},
        "timestamp": {"type": "number", "minimum": 0},
        "base_amount": {"type": "number", "minimum": 0},
        "base_currency": {"type": ["string", "null"]},
        "amount_sent": {"type": ["number", "null"], "minimum": 0},
        "sent_currency": {"type": ["string", "null"]},
        "amount_received": {"type": ["number", "null"], "minimum": 0},
        "receiving_currency": {"type": ["string", "null"]},
        "transaction_type": {"type": ["string", "null"]},
        "payment_format": {"type": ["string", "null"]},
        "scope": {"enum": ["candidate", "context", "unknown"]},
        "parent_edge_ids": {"type": "array", "items": {"type": "string"}},
        "mutation_role": {"enum": ["preserved", "modified", "added"]}
      },
      "not": {"required": ["causal_role"]}
    }
  }
}
